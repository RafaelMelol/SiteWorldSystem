# URL pública do site (usada em metadata, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.wsionline.com.br

# Envio de e-mail transacional (formulários de Contato, Newsletter e Oportunidades)
# via Resend (https://resend.com). Sem estas variáveis, as submissões são apenas
# registradas no log do servidor e o formulário responde com sucesso mesmo assim.
RESEND_API_KEY=
EMAIL_FROM="World System <contato@wsionline.com.br>"
EMAIL_TO=contato@wsionline.com.br
